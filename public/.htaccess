# Canonical hostname and scheme for the static site. HTTPS is terminated by the
# hosting proxy, so the forwarded protocol avoids redirect loops at Apache.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]
  RewriteCond %{HTTP_HOST} !^dadom\.pro$ [NC]
  RewriteRule ^ https://dadom.pro%{REQUEST_URI} [R=301,L,NE]

  # Generated fallback routes only exist to satisfy static export. They are not
  # public content and must remain inaccessible to visitors and crawlers.
  RewriteRule ^visual-preview(?:/|$) - [R=404,L]
  RewriteRule ^(?:projects|portfolio)/__empty(?:/|$) - [R=404,L]
  RewriteRule ^projects/category/__empty(?:/|$) - [R=404,L]
  RewriteRule ^(?:articles|technology)/__not-published(?:/|$) - [R=404,L]
</IfModule>